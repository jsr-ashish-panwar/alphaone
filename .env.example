# RoomMate Split (Alpha C-42) Environment Configuration

# Server Port
PORT=5000

# Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Atlas Database Connection URI
# Set your MongoDB Atlas connection string below:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# (If left empty or set to 'memory', an embedded in-memory MongoDB will be used for local testing)
MONGODB_URI=memory

# JWT Authentication Secret (Use a secure random 32+ character string)
JWT_SECRET=alpha_c42_super_secret_jwt_key_2026_roommate_split

# JWT Session Lifespan
JWT_EXPIRES_IN=7d

# Frontend Client URL (Used for strict CORS in production)
CLIENT_URL=http://localhost:5173
